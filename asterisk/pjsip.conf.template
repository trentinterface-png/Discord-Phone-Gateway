; Replace placeholders using scripts/render_config.py. Do NOT commit the resulting file.
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

; Only trust INVITEs coming from the gateway IP entered at deployment time.
[incoming-gateway]
type=endpoint
transport=transport-udp
context=from-gateway
disallow=all
allow=ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
aors=incoming-gateway

[incoming-gateway]
type=aor
max_contacts=1

[gateway-source]
type=identify
endpoint=incoming-gateway
match={{GATEWAY_IP}}

; Existing hosted SIP-to-Discord bridge, outbound challenge auth only.
[sipcord]
type=endpoint
transport=transport-udp
context=default
disallow=all
allow=ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
outbound_auth=sipcord-auth
aors=sipcord
from_user={{SIPCORD_USER}}
from_domain=bridge-usw1.sipcord.net

[sipcord]
type=aor
contact=sip:bridge-usw1.sipcord.net:5060
qualify_frequency=60

[sipcord-auth]
type=auth
auth_type=userpass
username={{SIPCORD_USER}}
password={{SIPCORD_PASSWORD}}
